# Copie ce fichier en .env et remplis tes vraies cles (jamais commitees, jamais dans le frontend)
DIFY_API_URL=https://api.dify.ai/v1/workflows/run
DIFY_API_KEY=
# Cle gratuite sur https://developer.tomtom.com (sans carte bancaire)
TOMTOM_API_KEY=
# Secours quand Dify ou Groq est indisponible. Cle gratuite sur https://aistudio.google.com (optionnelle)
GEMINI_API_KEY=
# Modele Gemini (optionnel, par defaut gemini-3.5-flash-lite)
GEMINI_MODEL=
PORT=3000
